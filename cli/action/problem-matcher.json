{
  "problemMatcher": [
    {
      "owner": "bea-check",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      ]
    },
    {
      "owner": "bea-format",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(would format: (.+))$",
          "file": 2,
          "message": 1
        }
      ]
    }
  ]
}
