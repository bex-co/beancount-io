;; beancount-import config
;; source: chase-checking
;;   account: Assets:Bank:Checking
;;   format: csv  columns: date=1,desc=2,amount=3  date_format: MDY  sign: negative=outflow
;;   csv_mapping: date=Date,narration=Description,amount=Amount,sign=bank
;;   date_format: %m/%d/%Y
;;   rules: ./import-rules.toml
;;   append_target: ./ledger.beancount
;;   imports: 1

option "title" "Synthetic importer graduation"
option "operating_currency" "USD"

2026-04-01 open Assets:Bank:Checking USD
2026-04-01 open Expenses:Food:Groceries USD
2026-04-01 open Expenses:Transport:Fuel USD
2026-04-01 open Expenses:Uncategorized USD
2026-04-01 open Income:Salary USD
2026-04-01 open Equity:Opening-Balances USD

2026-04-01 * "Opening balance"
  Assets:Bank:Checking       1000.00 USD
  Equity:Opening-Balances   -1000.00 USD

2026-04-03 * "TRADER JOES #123 SEATTLE WA"
  import-id: "csv:sha256:a8362f899f1ef12a"
  Assets:Bank:Checking        -33.20 USD
  Expenses:Food:Groceries      33.20 USD

2026-04-18 * "SHELL OIL 5551 KIRKLAND WA"
  import-id: "csv:sha256:99d7aab6b18d28d8"
  Assets:Bank:Checking        -40.00 USD
  Expenses:Transport:Fuel      40.00 USD
