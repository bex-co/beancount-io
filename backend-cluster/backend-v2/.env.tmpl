# --- Git over SSH proxy (ADR 0004) -----------------------------------------
# When enabled, backend-v2 terminates git over SSH itself instead of Gitea, so
# the main-only rule and every application-layer check apply to SSH as well as
# HTTP. Requires Gitea's SSH to be reachable in-network but not published.
#
# Off unless BOTH are set. Taking over the port with a host key nobody has seen
# gives every existing client the same warning a man-in-the-middle produces, so
# set SSH_PROXY_HOST_KEY to Gitea's existing host key — retrieve it with
# _infra/print-ssh-host-key.sh. It is a private key: never commit it.
SSH_PROXY_ENABLED=false
SSH_PROXY_PORT=2222
SSH_PROXY_HOST_KEY=
