# backend-v2 environment template.
# Copy to .env and fill in real values:  cp .env.example .env
# Leave unused optional secrets EMPTY — any non-empty placeholder is treated
# as a real credential. Never commit a filled .env.

# --- Core services (local defaults) ----------------------------------------
POSTGRES_BACKEND_URI=postgresql://user:password@localhost:5432/beancount
REDIS_URI=redis://localhost:6379
FAVA_API_URL=http://localhost:8000
FAVA_API_ADMIN_USER=admin
FAVA_API_ADMIN_PASSWORD=change-me
AUTH_SECRET=change-me
# Login/register JWT lifetime in minutes. Default 525600 (365 days).
# Override locally to test expiry, e.g. AUTH_JWT_EXP_MINUTES=5
AUTH_JWT_EXP_MINUTES=525600

# Public deployment URLs. Production OAuth uses DASHBOARD_URL as its
# issuer/front door; the local stack uses SERVER_URL for its direct backend.
# These are configuration, not secrets.
SERVER_URL=http://localhost:4104
DASHBOARD_URL=http://localhost:5173

# Email (SendGrid)
SEND_GRID_API_KEY=

# Admin API authentication token (also used for Claude Code Sandbox).
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=

# --- OAuth -----------------------------------------------------------------
# Production must receive a complete private P-256/ES256 JWKS as a deployment
# secret. Development and test generate an ephemeral process-local key.
# Without this secret in production, OAuth returns 503 oauth_not_configured
# (including /.well-known/oauth-protected-resource), which breaks MCP client
# discovery (ADR 0007 D4). Leave unset for local development.
OAUTH_JWKS=

# Identity OAuth 2.1 provider — static "discourse" client for the forum's
# "Log in with Beancount" button. Leave unset to keep the client disabled.
# Generate with: openssl rand -base64 32
OAUTH_DISCOURSE_CLIENT_SECRET=

# --- LLM (ADR 0011) --------------------------------------------------------
# All optional: the server boots with none set; AI calls then fail with
# "LLM is not configured". Receipt/file parsing, categorization, Plaid AI,
# and the in-process agent use ANTHROPIC_API_KEY (primary) and OPENAI_API_KEY
# (fallback).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides; defaults are claude-sonnet-4-5 / gpt-4o.
# Not ANTHROPIC_MODEL — that name belongs to the sandbox agent path.
LLM_MODEL=
LLM_FALLBACK_MODEL=
# Meters only the `bea ask` model proxy.
BLOCKEDEN_ACCESS_KEY=

# Claude Code Sandbox — /beancount-stream SSE endpoint.
# e.g. https://sandbox.beancount.io
CLAUDE_CODE_SANDBOX_URL=

# --- Stripe ----------------------------------------------------------------
# Production
STRIPE_PUBLIC_KEY=
STRIPE_PRIVATE_KEY=
STRIPE_WEBHOOK_SECRET=
# Development / test
STRIPE_DEV_PUBLIC_KEY=
STRIPE_DEV_PRIVATE_KEY=
STRIPE_DEV_WEBHOOK_SECRET=

# --- S3 (temporary asset uploads; auto-deleted after ~3 days) --------------
TEMP_ASSETS_AWS_S3_REGION=us-east-1
TEMP_ASSETS_AWS_S3_BUCKET=beancount-io-uploads-dev
TEMP_ASSETS_AWS_S3_ACCESS_KEY_ID=
TEMP_ASSETS_AWS_S3_SECRET_ACCESS_KEY=
# Optional custom endpoint (leave empty for AWS S3)
TEMP_ASSETS_AWS_S3_ENDPOINT=

# --- Observability ---------------------------------------------------------
# If set, logs are sent to Grafana Loki (e.g. http://loki:3100)
LOKI_HOST=

# --- Plaid -----------------------------------------------------------------
# https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=http://localhost:4104/api/plaid/webhook

# --- Git over SSH proxy (ADR 0004) -----------------------------------------
# When enabled, backend-v2 terminates git over SSH itself instead of Gitea.
# Off unless BOTH SSH_PROXY_ENABLED=true and SSH_PROXY_HOST_KEY are set.
# Set SSH_PROXY_HOST_KEY to Gitea's existing host key (private; never commit).
# Retrieve it with _infra/print-ssh-host-key.sh.
SSH_PROXY_ENABLED=false
SSH_PROXY_PORT=2222
SSH_PROXY_HOST_KEY=

# --- Native app links ------------------------------------------------------
# Unset → /.well-known/apple-app-site-association and assetlinks.json 404.
# Production: APP_LINKS_APPLE_TEAM_ID=PTLM7BZQMM; APP_LINKS_ANDROID_SHA256 is
# the Play App Signing certificate SHA-256 (colon-separated hex), comma-separated
# when more than one fingerprint is needed.
APP_LINKS_APPLE_TEAM_ID=
APP_LINKS_ANDROID_SHA256=
