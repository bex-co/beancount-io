{
  "name": "backend-v2",
  "version": "1.1.0",
  "description": "Beancount.io Backend",
  "main": "dist/..js",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register --transpile-only ./server.ts",
    "start": "ts-node -r tsconfig-paths/register --transpile-only ./server.ts",
    "dist:start": "node dist/server.js",
    "build": "tsc -b && tsc-alias -p tsconfig.json",
    "test": "jest --testPathIgnorePatterns='\\.integration\\.test\\.ts$'",
    "test:integration": "jest --testMatch='**/*.integration.test.ts'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "eval:categorize-transactions": "promptfoo eval -c evals/categorize-transactions/promptfooconfig.yaml",
    "eval:suggest-account-mapping": "promptfoo eval -c evals/suggest-account-mapping/promptfooconfig.yaml",
    "eval": "for f in evals/*/promptfooconfig.yaml; do echo \"→ $f\"; promptfoo eval -c \"$f\" || exit 1; done",
    "eval:view": "promptfoo view",
    "format": "prettier --write .",
    "lint": "eslint src --fix --ext .ts --quiet",
    "typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "kill": "lsof -n -i4TCP:4104 | grep LISTEN | awk '{ print $2 }' | xargs kill",
    "codegen": "yarn generate-backend-v2-openapi && yarn generate-fava-client && yarn generate-gitea-client && yarn generate-agent-tool-types",
    "generate-agent-tool-types": "ts-node -r tsconfig-paths/register --transpile-only scripts/generate-agent-tool-types.ts",
    "generate-backend-v2-openapi": "ts-node -r tsconfig-paths/register --transpile-only scripts/generate-openapi-spec.ts",
    "generate-v1-openapi": "ts-node -r tsconfig-paths/register --transpile-only scripts/generate-v1-openapi.ts",
    "generate-fava-client": "npx swagger-typescript-api generate --path ../idl/beancount-ledger.openapi.json -o src/foundation/fava",
    "generate-gitea-client": "npx swagger-typescript-api generate -p ../idl/gitea.swagger.v1.json -o src/features/gitea/client -n gitea-api.ts",
    "migrate:deploy": "node scripts/migrate-deploy.js"
  },
  "keywords": [
    "beancount",
    "web"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@koa/router": "^14.0.0",
    "@testcontainers/postgresql": "^11.11.0",
    "@testcontainers/redis": "^11.11.0",
    "@types/async-lock": "^1",
    "@types/bcryptjs": "2.4.2",
    "@types/dotenv": "6.1.1",
    "@types/graphql": "14.5.0",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "8.5.0",
    "@types/koa": "2.11.6",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/node": "25.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "2.5.7",
    "@types/oidc-provider": "^9.5.0",
    "@types/pg": "^8.16.0",
    "@types/ssh2": "^1.15.5",
    "@types/winston": "^2.4.4",
    "drizzle-kit": "^0.31.8",
    "eslint": "9.39.2",
    "globals": "^17.2.0",
    "jest": "^30.2.0",
    "jiti": "^2.6.0",
    "prettier": "3.8.1",
    "promptfoo": "^0.121.18",
    "swagger-typescript-api": "^13.2.13",
    "ts-jest": "29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "3.9.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.54.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/harness": "1.0.74",
