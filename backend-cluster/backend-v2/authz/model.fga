# Durable domain-relationship model for backend-v2, written in the OpenFGA DSL.
#
# This model answers only the Zanzibar-shaped question:
#
#   does stable user U have permission P on resource O?
#
# It contains no credentials, token scopes, request tuples, or authentication
# assurance. A centralized authorization PDP validates the signed subject
# context and grant envelope, then composes that decision with an OpenFGA Check.
# Microservices never construct authorization tuples from request credentials.
#
# This model remains documentation-as-code until that centralized PDP adopts it
# at runtime. CI validates the DSL and executes model.test.fga.yaml.

model
  schema 1.1

type user
  relations
    # A user is both an authorization subject and a protected User resource,
    # matching GitHub's User permission domain. `owner` is written only when the
    # subject and object contain the same stable internal `users.id`.
    define owner: [user]

    # Permission names follow `<level>_<capability>`. They map mechanically to
    # the centralized grant vocabulary `<resource>.<capability>:<level>`:
    # `can_read_profile` ↔ `user.profile:read`, for example. These answer
    # only the durable-relationship half of the PDP decision.
    define can_read_profile: owner
    define can_write_profile: owner
    define can_read_credentials: owner
    define can_write_credentials: owner
    define can_read_billing: owner
    define can_write_billing: owner
    define can_write_lifecycle: owner

type ledger
  relations
    # Durable facts resolved from the external Gitea-backed ledger service.
    # The resolver must emit exactly one effective collaborator rank per user
    # and ledger.
    define owner: [user]
    define collaborator_admin: [user]
    define collaborator_write: [user]
    define collaborator_read: [user]

    # Present as `user:*` iff the ledger is public. The type restriction
    # prevents an individual user from being written to this relation.
    define public_reader: [user:*]

    # Durable relationship-rank lattice: administrator ⊇ writer ⊇ reader.
    # Noun names keep these roles distinct from the `can_<level>_<capability>`
    # permissions below.
    define administrator: owner or collaborator_admin
    define writer: administrator or collaborator_write
    define reader: writer or collaborator_read or public_reader

    # GitHub-style permission families derived from the durable rank. These are
    # capabilities, not endpoint names. Fine-grained grants remain the PDP's
    # independent ceiling and use the matching `<resource>.<capability>:<level>`
    # name.
    define can_read_contents: reader
    define can_write_contents: writer
    define can_read_administration: administrator
    define can_write_administration: administrator
    define can_read_collaborators: administrator
    define can_write_collaborators: administrator
    define can_read_bank_connections: administrator
    define can_write_bank_connections: administrator
    define can_read_assets: reader
    define can_write_assets: writer
    define can_write_ai: writer
