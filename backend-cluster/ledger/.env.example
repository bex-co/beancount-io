# beancount-ledger-v2 — env vars mirror the retired Python service's Settings
# (formerly beancount-ledger/server/app/core/config.py, deleted at
# decommission) so the services stayed interchangeable behind the same
# compose wiring.

# Gitea (internal Docker hostname + port)
GITEA_HOST_NAME=beancount-gitea
GITEA_HTTP_PORT=3000

# Bearer token for /webhook/* routes (shared with the Gitea pre-receive hook)
WEBHOOK_TOKEN=

# backend-v2 (directive-limit lookups; empty admin token = checks skipped, fail open)
BACKEND_V2_HOST_NAME=backend-v2
BACKEND_V2_HTTP_PORT=4104
BACKEND_V2_ADMIN_TOKEN=

# Managed price includes (`include "https://beancount.io/prices/BTC-USD"`,
# ADR 015). Comma-separated feed origins; only https://beancount.io is allowed
# unless set, and an empty value disables the feature.
# The remaining knobs have defaults: refresh 300s, retry 60s, stale 600s,
# fetch timeout 5000ms, body cap 1048576 bytes, 16 feeds per ledger.
# MANAGED_PRICE_ORIGINS=https://beancount.io
# MANAGED_PRICE_REFRESH_SECONDS=300
# MANAGED_PRICE_RETRY_SECONDS=60
# MANAGED_PRICE_STALE_SECONDS=600
# MANAGED_PRICE_FETCH_TIMEOUT_MS=5000
# MANAGED_PRICE_MAX_BODY_BYTES=1048576
# MANAGED_PRICE_MAX_FEEDS=16

# Optional: Grafana Loki log shipping
# LOKI_HOST=

# Service port
PORT=8000
