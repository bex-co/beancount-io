option "title" "Report oracle: with price directives"
option "operating_currency" "USD"

; w23/m41. The same ledger with literal `price` directives, so the conversion
; modes have rates to use.

2026-01-01 open Assets:Bank:Checking   USD,EUR
2026-01-01 open Assets:Bank:Savings    USD
2026-01-01 open Assets:Broker          QAX,USD "FIFO"
2026-01-01 open Liabilities:Card       USD
2026-01-01 open Equity:Opening-Balances
2026-01-01 open Income:Salary          USD
2026-01-01 open Income:Gains           USD
2026-01-01 open Expenses:Food          USD
2026-01-01 open Expenses:Travel        EUR,USD

2026-01-02 * "Opening"
  Assets:Bank:Checking     5000.00 USD
  Equity:Opening-Balances

2026-01-15 * "Salary"
  Assets:Bank:Checking     3000.00 USD
  Income:Salary

2026-02-03 * "Groceries"
  Expenses:Food             120.40 USD
  Liabilities:Card

2026-03-01 pad Assets:Bank:Savings Equity:Opening-Balances
2026-03-02 balance Assets:Bank:Savings 800.00 USD

2026-07-01 * "Buy QAX"
  Assets:Broker            10 QAX {12.34 USD}
  Assets:Bank:Checking     -123.40 USD

2026-08-10 * "Hotel in Europe"
  Expenses:Travel          80.00 EUR @ 1.09 USD
  Assets:Bank:Checking     -87.20 USD

2026-09-01 * "Sell QAX"
  Assets:Broker            -4 QAX {12.34 USD} @ 15.00 USD
  Assets:Bank:Checking      60.00 USD
  Income:Gains             -10.64 USD

2026-06-30 price EUR 1.10 USD
2026-09-30 price EUR 1.12 USD
2026-09-30 price QAX 16.00 USD
