# deploy/docker-mac environment — copy to .env and adjust.
#
#   cp .env.example .env
#
# Every value here is a placeholder or a local-only default. Never commit .env
# (gitignored) and never put real credentials in this file.

# ── Secrets you should set before first boot ─────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# JSON array of cookie-signing secrets.
COOKIE_SECRETS=["change-me"]
# Admin API token shared between backend-v2 and the ledger service.
# Empty is allowed: directive-limit checks then fail open (skipped).
ADMIN_TOKEN=change-me-admin-token
# Gitea admin credentials. backend-v2 uses these to drive Gitea through the
# ledger service; post-docker-compose-up-build.sh creates the Gitea admin
# user from them.
FAVA_API_ADMIN_USER=beancount_admin
FAVA_API_ADMIN_PASSWORD=change-me-local-only

# ── URLs / ports (defaults match docker-compose.yml) ─────────────────────────
# Browser-facing GraphQL gateway, baked into the dashboard bundle at build time.
VITE_API_URL=http://localhost:42601/api-gateway/
SERVER_URL=http://localhost:42601
DASHBOARD_URL=http://localhost:42600
EXTERNAL_GITEA_HOST_NAME=localhost
EXTERNAL_GITEA_HTTP_PORT=42602

# ── Databases (local-only dev defaults) ──────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=gitea
POSTGRES_BACKEND_USER=postgres
POSTGRES_BACKEND_PASSWORD=password
POSTGRES_BACKEND_DB=backend
POSTGRES_BACKEND_URI=postgresql://postgres:password@postgres-backend:5432/backend
REDIS_URI=redis://redis:6379

# ── Gitea hardening (optional for a local stack) ─────────────────────────────
# Generate each with: openssl rand -hex 32
GITEA__security__SECRET_KEY=
GITEA__security__INTERNAL_TOKEN=
GITEA__server__LFS_JWT_SECRET=
GITEA__oauth2__JWT_SECRET=

# ── Git over SSH (optional; see README.md) ───────────────────────────────────
# Set to true AND uncomment the 42607 port mapping in docker-compose.yml.
SSH_PROXY_ENABLED=false
# Gitea's own SSH host key (PEM). Fill via: ./print-ssh-host-key.sh > ...
SSH_PROXY_HOST_KEY=
GITEA_SSH_PORT=42607

# ── AI features (optional) ───────────────────────────────────────────────────
# Placeholder boots the server; a real key is needed to use AI features.
BLOCKEDEN_ACCESS_KEY=local-dev-placeholder
# URL of your own Claude Code sandbox deployment (sandboxed ask-agent mode).
CLAUDE_CODE_SANDBOX_URL=
ANTHROPIC_API_KEY=
# Uncomment ONLY with a real, non-empty URL — an empty value crashes backend-v2
# at startup (@ai-sdk/anthropic rejects an empty baseURL at import time).
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Optional integrations (unset ⇒ feature disabled) ─────────────────────────
METRICS_API_TOKEN=
SEND_GRID_API_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_PRIVATE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEV_PUBLIC_KEY=
STRIPE_DEV_PRIVATE_KEY=
STRIPE_DEV_WEBHOOK_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=
TEMP_ASSETS_AWS_S3_REGION=us-east-1
TEMP_ASSETS_AWS_S3_BUCKET=
TEMP_ASSETS_AWS_S3_ACCESS_KEY_ID=
TEMP_ASSETS_AWS_S3_SECRET_ACCESS_KEY=
TEMP_ASSETS_AWS_S3_ENDPOINT=
PERM_ASSETS_AWS_S3_REGION=us-east-1
PERM_ASSETS_AWS_S3_BUCKET=
PERM_ASSETS_AWS_S3_ACCESS_KEY_ID=
PERM_ASSETS_AWS_S3_SECRET_ACCESS_KEY=
PERM_ASSETS_AWS_S3_ENDPOINT=
LOKI_HOST=
LOG_LEVEL=debug
