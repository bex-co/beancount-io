# deploy/dev-sandbox environment — copy to .env and adjust, or just run ./up.sh
# which creates .env from this file and fills in generated secrets + your LAN IP.
#
# Every value here is a placeholder or a local-only default. Never commit .env
# (gitignored) and never put real credentials in this file.

# ── Secrets (up.sh replaces every change-me with `openssl rand -hex 24`) ─────
AUTH_SECRET=change-me-generate-with-openssl-rand
# JSON array of cookie-signing secrets.
COOKIE_SECRETS=["change-me"]
# Admin API token shared between backend-v2, the ledger service, AND the
# agent-box worker (up.sh writes it into backend-cluster/agent-box/.dev.vars —
# the control plane 401s unless both sides hold the same value).
ADMIN_TOKEN=change-me-admin-token
# Gitea admin credentials. backend-v2 uses these to drive Gitea through the
# ledger service; provision.sh creates the Gitea admin user from them.
FAVA_API_ADMIN_USER=beancount_admin
FAVA_API_ADMIN_PASSWORD=change-me-local-only

# ── URLs / ports (defaults match docker-compose.yml; 4261x ≠ docker-mac 4260x
#    so both stacks can run side by side) ────────────────────────────────────
VITE_API_URL=http://localhost:42611/api-gateway/
SERVER_URL=http://localhost:42611
DASHBOARD_URL=http://localhost:42610
# The clone-URL host for ledger repos. It must be reachable BOTH from this Mac
# and from inside the sandbox docker container that clones the ledger, and it
# must stay an IP or `localhost` (backend-v2 generates https URLs for anything
# else). `auto` ⇒ up.sh substitutes the Mac's LAN IP.
EXTERNAL_GITEA_HOST_NAME=auto
EXTERNAL_GITEA_HTTP_PORT=42612
GITEA__server__ROOT_URL=http://localhost:42612/

# ── Ask-AI sandbox (the reason this target exists) ───────────────────────────
# agent-box control plane, run by up.sh on the host via `wrangler dev`.
# host.docker.internal:8787 is how backend-v2 (in compose) reaches it.
CLAUDE_CODE_SANDBOX_URL=http://host.docker.internal:8787

# Model credentials forwarded into the sandbox where Claude Code runs.
#
# DEFAULT: a local Ollama model impersonating the Anthropic API — zero cloud
# cost, fully offline. up.sh starts `ollama serve` and aliases the Claude model
# ids the backend pins (e.g. claude-sonnet-4-5-*) to DEV_SANDBOX_LOCAL_MODEL.
# host.docker.internal:11434 = the host's Ollama, reachable from the sandbox
# container. NOTE: this base URL also applies to backend-v2's own LLM features.
#
# REAL ANTHROPIC API instead: set ANTHROPIC_API_KEY=sk-ant-..., clear
# ANTHROPIC_AUTH_TOKEN, and REMOVE the ANTHROPIC_BASE_URL line entirely (an
# empty value crashes backend-v2 at startup — see docker-compose.yml).
ANTHROPIC_BASE_URL=http://host.docker.internal:11434
ANTHROPIC_AUTH_TOKEN=ollama
ANTHROPIC_API_KEY=
# Claude Code in the sandbox picks its model from these envs (the ACP modelId
# is not reliably honored). Both names must exist as Ollama aliases —
# ollama-models.sh creates them. Clear both when using the real Anthropic API.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-5-20251001
# Claude Code per-request timeout: local prefill of the ~30k-token system
# prompt can take minutes, and the default ~60s timeout cancels mid-prefill.
API_TIMEOUT_MS=600000
# Context window baked into the Ollama aliases; raise toward the model's
# training limit so multi-turn Claude Code conversations fit.
DEV_SANDBOX_LOCAL_MODEL_CTX=40960
# Local model that answers for the pinned Claude model ids (must be pulled in
# Ollama already, or `ollama pull` it first). Needs tool-calling support.
DEV_SANDBOX_LOCAL_MODEL=qwen3:32b
# Uncomment if your Ollama model store lives somewhere non-default; up.sh
# exports it before starting `ollama serve`.
# OLLAMA_MODELS=

# ── Databases (local-only dev defaults) ──────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=gitea
POSTGRES_BACKEND_USER=postgres
POSTGRES_BACKEND_PASSWORD=password
POSTGRES_BACKEND_DB=backend
POSTGRES_BACKEND_URI=postgresql://postgres:password@postgres-backend:5432/backend
REDIS_URI=redis://redis:6379

# ── Gitea hardening (optional for a local stack) ─────────────────────────────
# Generate each with: openssl rand -hex 32
GITEA__security__SECRET_KEY=
GITEA__security__INTERNAL_TOKEN=
GITEA__server__LFS_JWT_SECRET=
GITEA__oauth2__JWT_SECRET=

# ── AI features (optional beyond the sandbox path) ───────────────────────────
# Placeholder boots the server; the sandbox path uses ANTHROPIC_* above.
BLOCKEDEN_ACCESS_KEY=local-dev-placeholder
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Optional integrations (unset ⇒ feature disabled) ─────────────────────────
METRICS_API_TOKEN=
SEND_GRID_API_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_PRIVATE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEV_PUBLIC_KEY=
STRIPE_DEV_PRIVATE_KEY=
STRIPE_DEV_WEBHOOK_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=
TEMP_ASSETS_AWS_S3_REGION=us-east-1
TEMP_ASSETS_AWS_S3_BUCKET=
TEMP_ASSETS_AWS_S3_ACCESS_KEY_ID=
TEMP_ASSETS_AWS_S3_SECRET_ACCESS_KEY=
TEMP_ASSETS_AWS_S3_ENDPOINT=
PERM_ASSETS_AWS_S3_REGION=us-east-1
PERM_ASSETS_AWS_S3_BUCKET=
PERM_ASSETS_AWS_S3_ACCESS_KEY_ID=
PERM_ASSETS_AWS_S3_SECRET_ACCESS_KEY=
PERM_ASSETS_AWS_S3_ENDPOINT=
LOKI_HOST=
LOG_LEVEL=debug
