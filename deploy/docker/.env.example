# deploy/docker environment — copy to .env and replace every change-me value.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Generate secrets with `openssl rand -hex 32`. Hex values are also safe when
# Compose builds the PostgreSQL connection URI from the password.

# ── Public endpoints ────────────────────────────────────────────────────────
# Create A/AAAA records for all three names pointing at this Docker host before
# starting Caddy. Do not include a scheme, slash, or port.
APP_DOMAIN=books.example.com
API_DOMAIN=api.books.example.com
GIT_DOMAIN=git.books.example.com
ACME_EMAIL=admin@example.com

# ── Application secrets ────────────────────────────────────────────────────
AUTH_SECRET=change-me-auth-secret
DASHBOARD_OAUTH_TRANSACTION_SECRET=change-me-dashboard-oauth-transaction-secret
# JSON array of cookie-signing secrets. Keep the outer JSON syntax intact.
COOKIE_SECRETS=["change-me-cookie-secret"]
# Shared by backend-v2 and ledger. Empty would make ledger-limit checks fail
# open, so the production Compose file requires a non-empty value.
ADMIN_TOKEN=change-me-admin-token
METRICS_API_TOKEN=change-me-metrics-token
AUTH_JWT_EXP_MINUTES=525600

# Gitea admin account used by backend-v2. The one-shot gitea-init service
# creates this user on first boot.
FAVA_API_ADMIN_USER=beancount_admin
FAVA_API_ADMIN_PASSWORD=change-me-gitea-admin-password
GITEA_ADMIN_EMAIL=admin@example.com

# ── Data stores ─────────────────────────────────────────────────────────────
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change-me-gitea-database-password
GITEA_DB_NAME=gitea
BACKEND_DB_USER=beancount
BACKEND_DB_PASSWORD=change-me-backend-database-password
BACKEND_DB_NAME=beancount

# These values protect persisted Gitea sessions, tokens, and LFS credentials.
# Do not rotate them casually after first boot.
GITEA_SECRET_KEY=change-me-gitea-secret-key
GITEA_INTERNAL_TOKEN=change-me-gitea-internal-token
GITEA_LFS_JWT_SECRET=change-me-gitea-lfs-jwt-secret
GITEA_OAUTH2_JWT_SECRET=change-me-gitea-oauth2-jwt-secret

# ── Image tracks ────────────────────────────────────────────────────────────
# These defaults follow patch releases within tested major/minor lines. Pin a
# full tag or digest here when your deployment policy requires immutability.
CADDY_IMAGE=caddy:2-alpine
GITEA_IMAGE=docker.gitea.com/gitea:1.24
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
BEANCOUNT_IMAGE_TAG=selfhosted

# ── AI features (optional) ──────────────────────────────────────────────────
# The placeholder lets backend-v2 boot but does not enable AI. Replace it with
# a real BlockEden key, or configure one of the provider-specific alternatives.
BLOCKEDEN_ACCESS_KEY=local-dev-placeholder
ANTHROPIC_API_KEY=
# Do not set ANTHROPIC_BASE_URL to an empty string; see README.md.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ASK_AI_MODE=bql
AGENT_MODE=self-hosted
CLAUDE_CODE_SANDBOX_URL=
CLAUDE_CODE_AGENT_URL=

# ── Optional integrations ───────────────────────────────────────────────────
SEND_GRID_API_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_PRIVATE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEV_PUBLIC_KEY=
STRIPE_DEV_PRIVATE_KEY=
STRIPE_DEV_WEBHOOK_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=
TEMP_ASSETS_AWS_S3_REGION=us-east-1
TEMP_ASSETS_AWS_S3_BUCKET=
TEMP_ASSETS_AWS_S3_ACCESS_KEY_ID=
TEMP_ASSETS_AWS_S3_SECRET_ACCESS_KEY=
TEMP_ASSETS_AWS_S3_ENDPOINT=
PERM_ASSETS_AWS_S3_REGION=us-east-1
PERM_ASSETS_AWS_S3_BUCKET=
PERM_ASSETS_AWS_S3_ACCESS_KEY_ID=
PERM_ASSETS_AWS_S3_SECRET_ACCESS_KEY=
PERM_ASSETS_AWS_S3_ENDPOINT=
LOKI_HOST=
LOG_LEVEL=info

# ── Git over SSH (optional) ─────────────────────────────────────────────────
# HTTP Git works without these. See README.md before enabling the SSH override.
SSH_PORT=2222
SSH_PROXY_HOST_KEY=
