{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "entry": [
    // GraphQL Codegen loads these custom schema loaders from codegen.ts.
    "scripts/codegen-schema-file-loader.cjs",
    "scripts/codegen-schema-loader.cjs",
    // Vitest resolves this test double through its monaco-editor alias.
    "src/test/mocks/monaco-editor.ts",
  ],
  "ignoreIssues": {
    // TanStack Start discovers and calls the exported router factory.
    "src/router.tsx": ["exports"],
  },
}
