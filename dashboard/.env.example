# API Gateway URL used by the browser / CSR. Keep this on the Dashboard origin
# so its host-only HttpOnly OAuth cookie reaches GraphQL, REST, and agent calls.
VITE_API_URL=/api-gateway/

# SSR API URL (optional, used by the Node.js SSR server)
# When running in Docker, the SSR server may need to reach the backend via an
# internal network URL (e.g., http://backend-v2:4104/api-gateway/) while the
# browser still uses the public VITE_API_URL above.
# If not set, defaults to VITE_API_URL. Local SSR needs the direct backend URL.
VITE_SSR_API_URL=http://localhost:4104/api-gateway/
#
# In a DEPLOYED environment set SSR_API_URL instead: it is read at runtime (see
# src/config/config.server.ts), so one image works in every environment, and it
# must be the INTERNAL address — a deployed SSR server cannot reach the backend
# through its own public ingress.
# SSR_API_URL=http://backend-v2:4104/api-gateway/

# Server-only HMAC key for the short-lived OAuth state/PKCE transaction cookie.
# Required in production; generate with `openssl rand -base64 32`. Never use a
# VITE_ prefix or expose it to browser code.
# DASHBOARD_OAUTH_TRANSACTION_SECRET=

# Google Analytics 4 Measurement ID for this environment's data stream.
# Use a SEPARATE stream per environment so dev/staging traffic never mixes with
# production: set the dev/staging stream's ID here in non-prod builds and the
# production stream's ID in prod. Non-production builds also send events with
# GA4 debug_mode so you can validate instrumentation in GA4 DebugView.
# When unset, analytics is disabled entirely (no GA script is loaded).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Read-only Google Search Console service-account JSON, encoded as one Base64 line.
# Used only by the local/CI search-console-report script; never expose it to Vite/client code.
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=
