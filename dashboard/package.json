{
  "name": "beancount-dashboard",
  "description": "Web dashboard for Beancount.io — double-entry bookkeeping in the browser.",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "homepage": "https://beancount.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/bex-co/beancount-io.git",
    "directory": "dashboard"
  },
  "type": "module",
  "packageManager": "yarn@4.17.0",
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "start": "PORT=5173 node .output/server/index.mjs",
    "generate-routes": "tsr generate",
    "preview": "yarn build && yarn start",
    "typecheck": "yarn generate-routes && tsc -b",
    "lint": "yarn generate-routes && tsc -b && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:translations": "vitest run src/test/translations.test.ts",
    "test:translations:watch": "vitest watch src/test/translations.test.ts",
    "kill": "lsof -n -i4TCP:5173 | grep LISTEN | awk '{ print $2 }' | xargs kill",
    "i18n:prepare": "tsx scripts/prepare-translations.ts",
    "i18n:flatten": "tsx scripts/flatten-translation-keys.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.187",
    "@apollo/client": "^4.1.3",
    "@hookform/resolvers": "^5.2.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.9.10",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.167.0",
    "@tanstack/react-router-devtools": "^1.166.7",
    "@tanstack/react-router-ssr-query": "^1.166.7",
    "@tanstack/react-start": "^1.166.11",
    "@types/react-window": "^2.0.0",
    "ai": "^6.0.57",
    "ai-elements": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "graphql": "^16.11.0",
    "i18next": "^25.7.3",
    "input-otp": "^1.4.2",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.55.1",
    "monaco-textmate": "^3.0.1",
    "nanoid": "5.1.6",
    "nitro": "npm:nitro-nightly@latest",
    "numbro": "^2.5.0",
    "react": "^19.2.3",
    "react-day-picker": "^9.13.0",
    "react-diff-view": "3.1.0",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.1.0",
    "react-hook-form": "^7.69.0",
    "react-i18next": "^16.5.0",
    "react-markdown": "^10.1.0",
    "react-plaid-link": "^4.1.1",
    "react-window": "^2.2.4",
    "refractor": "^4.9.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "vscode-oniguruma": "^2.0.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/typed-document-node": "^6.1.5",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-operations": "^5.0.7",
