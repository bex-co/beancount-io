{
  "expo": {
    "version": "1.20260821.44",
    "name": "Beancount",
    "scheme": ["beancount", "io.beancount.ios", "io.beancount.android"],
    "slug": "beancount",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/eef0c5cf-1a6f-4566-a6a6-e03821db7f8d"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.beancount.ios",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "NSCalendarsUsageDescription": false,
        "NSCameraUsageDescription": "Beancount uses the camera to scan receipts.",
        "NSContactsUsageDescription": false,
        "NSLocationWhenInUseUsageDescription": false,
        "NSLocationAlwaysUsageDescription": false,
        "NSLocationAlwaysAndWhenInUseUsageDescription": false,
        "NSMicrophoneUsageDescription": false,
        "NSMotionUsageDescription": false,
        "NSPhotoLibraryUsageDescription": "Beancount accesses your photos to scan receipts.",
        "NSPhotoLibraryAddUsageDescription": false,
        "NSFaceIDUsageDescription": false,
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "44"
    },
    "android": {
      "versionCode": 44,
      "package": "io.beancount.android",
      "permissions": ["com.google.android.gms.permission.AD_ID"],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon-adaptive-foreground.png",
        "monochromeImage": "./src/assets/images/icon-adaptive-foreground.png",
        "backgroundColor": "#5fc535"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/JetBrainsMono-Regular.ttf",
            "./src/assets/fonts/JetBrainsMono-Medium.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/icon.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#171a14"
          },
          "android": {
            "image": "./src/assets/images/icon-adaptive-foreground.png",
            "imageWidth": 320
          }
        }
      ],
      [
        "expo-asset",
        {
          "assets": ["./src/assets"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photo library to attach receipts"
        }
      ],
      "expo-localization",
      "expo-router",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "eef0c5cf-1a6f-4566-a6a6-e03821db7f8d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
