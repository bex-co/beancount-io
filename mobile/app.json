{
  "expo": {
    "version": "1.20261002.50",
    "name": "Beancount",
    "scheme": ["beancount", "io.beancount.ios", "io.beancount.android"],
    "slug": "beancount",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/eef0c5cf-1a6f-4566-a6a6-e03821db7f8d"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.beancount.ios",
      "userInterfaceStyle": "automatic",
      "associatedDomains": ["applinks:beancount.io"],
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "zh",
          "bg",
          "ca",
          "de",
          "es",
          "fa",
          "fr",
          "nl",
          "pt",
          "ru",
          "sk",
          "uk"
        ],
        "NSCalendarsUsageDescription": false,
        "NSCameraUsageDescription": "Beancount uses the camera to scan receipts.",
        "NSContactsUsageDescription": false,
        "NSLocationWhenInUseUsageDescription": false,
        "NSLocationAlwaysUsageDescription": false,
        "NSLocationAlwaysAndWhenInUseUsageDescription": false,
        "NSMicrophoneUsageDescription": false,
        "NSMotionUsageDescription": false,
        "NSPhotoLibraryUsageDescription": "Beancount accesses your photos to scan receipts.",
        "NSPhotoLibraryAddUsageDescription": false,
        "NSFaceIDUsageDescription": false,
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "50"
    },
    "locales": {
      "en": "./locales/ios/en.json",
      "zh": "./locales/ios/zh.json",
      "bg": "./locales/ios/bg.json",
      "ca": "./locales/ios/ca.json",
      "de": "./locales/ios/de.json",
      "es": "./locales/ios/es.json",
      "fa": "./locales/ios/fa.json",
      "fr": "./locales/ios/fr.json",
      "nl": "./locales/ios/nl.json",
      "pt": "./locales/ios/pt.json",
      "ru": "./locales/ios/ru.json",
      "sk": "./locales/ios/sk.json",
      "uk": "./locales/ios/uk.json"
    },
    "android": {
      "versionCode": 50,
      "package": "io.beancount.android",
      "permissions": ["com.google.android.gms.permission.AD_ID"],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon-adaptive-foreground.png",
        "monochromeImage": "./src/assets/images/icon-adaptive-foreground.png",
        "backgroundColor": "#5fc535"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "beancount.io",
              "pathPattern": "/ledger/..*/..*"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/JetBrainsMono-Regular.ttf",
            "./src/assets/fonts/JetBrainsMono-Medium.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/icon.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#171a14"
          }
        }
      ],
      [
        "expo-asset",
        {
          "assets": ["./src/assets"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Beancount uses the camera to scan receipts.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Beancount accesses your photos to scan receipts.",
          "cameraPermission": "Beancount uses the camera to scan receipts.",
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "expo-router",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "eef0c5cf-1a6f-4566-a6a6-e03821db7f8d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
